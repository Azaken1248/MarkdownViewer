# Dependencies
node_modules/
# package-lock.json is deliberately NOT ignored. It is what makes `npm ci`
# reproducible, and the README lists it as part of the project.

# OS
.DS_Store
Thumbs.db

*.docx

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Environment
.env
.env.local

# Logs
logs/
*.log
npm-debug.log*

# Build
dist/
build/

# App data and user documents (runtime state, recreated by the server on boot)
data/
deleted_markdowns/
public/docs/
assets/

# Optional bundles (npm run build). Absent = the pages serve the individual
# scripts they name, which is the development path and stays working.
public/build/

# `npm run coverage` writes its report here
coverage/

# The bearer token Prometheus scrapes with. deploy/ is configuration anybody
# can read; this is the one file in it that is a credential.
deploy/metrics-token
