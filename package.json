{
  "name": "azadocs",
  "version": "1.0.0",
  "private": true,
  "main": "server.js",
  "description": "A self-hosted markdown library with full-text search, in-place editing, and inline Mermaid, LaTeX and Jupyter rendering.",
  "license": "MIT",
  "author": "Azaken1248",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Azaken1248/MarkdownViewer.git"
  },
  "homepage": "https://md.azaken.com",
  "bugs": {
    "url": "https://github.com/Azaken1248/MarkdownViewer/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build": "node tools/build.js",
    "test": "node test/run.js",
    "coverage": "c8 node test/run.js",
    "lint": "eslint .",
    "audit:cdn": "node tools/audit-cdn.js --level=moderate",
    "smoke": "node tools/smoke.js",
    "backup": "node tools/backup.js",
    "restore": "node tools/restore.js",
    "typecheck": "tsc -p jsconfig.json",
    "lint:fix": "eslint . --fix",
    "images": "node tools/make-embed-images.js",
    "icons": "node tools/make-icon-sprite.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "express": "^5.2.1",
    "graphql": "^16.13.2",
    "graphql-http": "^1.22.4",
    "multer": "^2.1.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.19.43",
    "c8": "^12.0.0",
    "dompurify": "3.4.16",
    "esbuild": "^0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "eslint-plugin-security": "4.0.1",
    "jsdom": "^25.0.1",
    "lucide-static": "^1.34.0",
    "typescript": "^7.0.2"
  }
}
