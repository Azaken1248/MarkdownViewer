{
  "name": "azadocs",
  "version": "1.0.0",
  "private": true,
  "description": "A personal markdown library with a file explorer, live editor, Mermaid diagrams and full-text search.",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build": "node tools/build.js",
    "test": "node test/run.js",
    "coverage": "c8 node test/run.js",
    "lint": "eslint .",
    "typecheck": "tsc -p jsconfig.json",
    "lint:fix": "eslint . --fix",
    "images": "node tools/make-embed-images.js",
    "icons": "node tools/make-icon-sprite.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "express": "^5.2.1",
    "graphql": "^17.0.2",
    "graphql-http": "^1.22.4",
    "multer": "^2.1.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.19.43",
    "c8": "^12.0.0",
    "esbuild": "^0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "eslint-plugin-security": "4.0.1",
    "jsdom": "^25.0.1",
    "lucide-static": "^1.34.0",
    "typescript": "^7.0.2"
  }
}
